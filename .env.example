# Copy this file to `.env` (same directory) and fill in your own values.
# The root `.env` is gitignored and is read by `docker compose` for variable
# substitution (db password, backend DATABASE_URL, frontend URLs).

# Local PostgreSQL credentials (used by the `db` service)
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=audio_analyzer

# Backend connection string (password must be URL-encoded, e.g. @ -> %40)
DATABASE_URL=postgresql+asyncpg://postgres:change_me_strong_password@db:5432/audio_analyzer

# Frontend: base URL the browser uses to reach the FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000
