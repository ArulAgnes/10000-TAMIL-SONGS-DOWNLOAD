# Audio storage (filesystem — audio is NEVER stored in SQL)
AUDIO_STORAGE_PATH=./audio_collection
ARCHIVE_DIR=./archives
TEMP_DIR=./temp

# Database (metadata only: crawl jobs, years, categories, albums, songs,
# download status, statistics). Defaults to local SQLite; PostgreSQL is also
# supported, e.g. postgresql+asyncpg://postgres:postgres@localhost:5432/audio_analyzer
DATABASE_URL=sqlite+aiosqlite:///./audio_analyzer.db

# Crawler Configuration
MAX_CONCURRENCY=5
REQUEST_TIMEOUT=30
MAX_RETRIES=3
REQUEST_DELAY_MS=500
USER_AGENT="AudioCollectionAnalyzer/1.0"

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# Security
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
